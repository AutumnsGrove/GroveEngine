{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler"
	},
	// Showroom maps $lib → engine/src/lib, so the auto-generated tsconfig
	// includes every engine source file. Exclude categories that showroom
	// never needs to type-check directly.
	"exclude": [
		// Re-include parent excludes (child exclude replaces parent)
		"node_modules/**",
		"src/service-worker.js",
		"src/service-worker/**/*.js",
		"src/service-worker.ts",
		"src/service-worker/**/*.ts",
		"src/service-worker.d.ts",
		"src/service-worker/**/*.d.ts",
		// Engine test files — no vitest types in showroom scope
		"../../libs/engine/src/lib/**/*.test.ts",
		// Email templates — JSX not configured in showroom
		"../../libs/engine/src/lib/email/**",
		// Server-only code — references App.Platform/App.Locals from engine's app.d.ts
		"../../libs/engine/src/lib/**/server/**",
		// SvelteKit-specific adapters — reference Platform.env
		"../../libs/engine/src/lib/loom/adapters/sveltekit.ts"
	]
}
