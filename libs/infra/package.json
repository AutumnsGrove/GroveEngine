{
	"name": "@autumnsgrove/infra",
	"version": "0.1.0",
	"description": "Infrastructure abstraction layer for Grove — the roots run deep, the tree stands anywhere",
	"author": "AutumnsGrove",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AutumnsGrove/Lattice.git",
		"directory": "libs/infra"
	},
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./cloudflare": {
			"types": "./src/cloudflare/index.ts",
			"default": "./src/cloudflare/index.ts"
		},
		"./testing": {
			"types": "./src/testing/index.ts",
			"default": "./src/testing/index.ts"
		},
		"./response": {
			"types": "./src/response.ts",
			"default": "./src/response.ts"
		},
		"./middleware": {
			"types": "./src/middleware/auth.ts",
			"default": "./src/middleware/auth.ts"
		},
		"./vite": {
			"default": "./src/vite/grove-vite-config.js"
		}
	},
	"files": [
		"src"
	],
	"scripts": {
		"check": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"dependencies": {
		"@autumnsgrove/grove-errors": "workspace:*",
		"hono": "^4.11.9"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260317.1",
		"@sveltejs/kit": "^2.50.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.0"
	},
	"keywords": [
		"grove",
		"infra",
		"infrastructure",
		"cloudflare",
		"abstraction",
		"adapters"
	]
}
