{
	"name": "@autumnsgrove/grove-markdown",
	"version": "0.1.0",
	"description": "Grove markdown content pipeline — parsing, sanitization, directives, hum embeds, mentions.",
	"author": "AutumnsGrove",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AutumnsGrove/Lattice.git",
		"directory": "libs/grove-markdown"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"default": "./src/*.ts"
		},
		"./hum": {
			"types": "./src/hum/index.ts",
			"default": "./src/hum/index.ts"
		},
		"./hum/providers": {
			"types": "./src/hum/providers/index.ts",
			"default": "./src/hum/providers/index.ts"
		}
	},
	"files": [
		"src"
	],
	"scripts": {
		"check": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"dependencies": {
		"@11ty/gray-matter": "^2.0.1",
		"dompurify": "^3.3.1",
		"esm-env": "^1.2.2",
		"markdown-it": "^14.1.1",
		"markdown-it-footnote": "^4.0.0",
		"sanitize-html": "^2.17.0"
	},
	"devDependencies": {
		"@types/markdown-it": "^14.1.2",
		"@types/markdown-it-footnote": "^3.0.4",
		"@types/sanitize-html": "^2.16.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.0"
	},
	"keywords": [
		"grove",
		"markdown",
		"content",
		"hum",
		"mentions",
		"directives"
	]
}
