#!/bin/bash
# Lattice pre-push hook — thin shim calling scripts/pre-push/validate.mjs
#
# Real logic lives in scripts/pre-push/ so it runs identically in local
# dev, Claude Code web sandboxes, and (for humans running the script
# directly) anywhere else. Single source of truth shared with
# validate-deployments.yml via the deploy-manifest parser.
#
# Install (once per clone):
#   git config core.hooksPath .githooks
#
# Bypass (sparingly — you'll get a rude comment on the PR):
#   git push --no-verify

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
exec node "$REPO_ROOT/scripts/pre-push/validate.mjs" "$@"
